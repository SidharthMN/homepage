{
  "version": 2,
  "builds": [
    {
      "src": "backend_py/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "script.js",
      "use": "@vercel/static"
    },
    {
      "src": "style.css",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/wallpapers/",
      "dest": "backend_py/main.py"
    },
    {
      "src": "/news/",
      "dest": "backend_py/main.py"
    },
    {
      "src": "/upload-wallpaper/",
      "dest": "backend_py/main.py"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "backend_py/main.py"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
