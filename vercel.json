{
  "version": 2,
  "builds": [
    {
      "src": "backend_py/main.py",
      "use": "@vercel/python"
    }
  ],
  "rewrites": [
    {
      "source": "/wallpapers/",
      "destination": "backend_py/main.py"
    },
    {
      "source": "/upload-wallpaper/",
      "destination": "backend_py/main.py"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "backend_py/main.py"
    }
  ]
}
